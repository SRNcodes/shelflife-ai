# Copy to .env and fill in real values. Never commit .env.

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg2://shelflife:shelflife@localhost:5432/shelflife

# Claude API key - set a spending limit on this key per docs/brief.md
ANTHROPIC_API_KEY=

# Local image storage for Week 1 (swap for S3 later)
UPLOAD_DIR=./uploads

# How many days out counts as "expiring soon" for the reminder banner
EXPIRING_SOON_DAYS=3
